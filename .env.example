# Copy this file to .env.local and fill in the values (Git ignores .env.local).
# Deployed Sepolia contract address: 42 characters starting with 0x.
VITE_CONTRACT_ADDRESS=
# Optional Sepolia RPC for read-only browsing. Leave blank to read through MetaMask.
VITE_SEPOLIA_RPC_URL=
# Cloudflare Worker relay that pins evidence CAR files to IPFS.
VITE_PIN_RELAY_URL=
# Optional shared header key expected by the Worker. Leave blank when the Worker
# uses another abuse control (Turnstile or a signature allowlist).
VITE_PIN_RELAY_KEY=
