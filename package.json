{
  "name": "dapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:contract": "node scripts/compile-contract.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:contract": "node --test tests/milestone-fund.test.mjs",
    "test:unit": "node --test tests/utils.test.mjs tests/wallet.test.mjs",
    "format:check": "node scripts/check-format.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "@ipld/dag-pb": "^4.2.0",
    "ethers": "^6.15.0",
    "multiformats": "^14.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@vitejs/plugin-react": "^4.7.0",
    "solc": "0.8.24",
    "solc-deployed": "npm:solc@0.8.34",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
